{
  "name": "aeralyth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run worker:build",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate:base && npm run db:migrate:e2ee && npm run db:migrate:shares",
    "db:migrate:base": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U aeralyth -d aeralyth -f /docker-entrypoint-initdb.d/001_auth.sql",
    "db:migrate:e2ee": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U aeralyth -d aeralyth -f /docker-entrypoint-initdb.d/002_e2ee.sql",
    "db:migrate:shares": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U aeralyth -d aeralyth -f /docker-entrypoint-initdb.d/003_share_links.sql",
    "build": "next build",
    "prebuild": "npm run worker:build",
    "worker:build": "npm run worker:zip && npm run worker:vault",
    "worker:zip": "esbuild src/features/dashboard/folder-zip.worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/folder-zip.worker.js",
    "worker:vault": "esbuild src/features/vault/vault.worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/vault.worker.js",
    "start": "next start",
    "lint": "biome check",
    "test": "vitest run",
    "format": "biome format --write"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@uiw/color-convert": "^2.10.3",
    "@uiw/react-color-hue": "^2.10.3",
    "@uiw/react-color-saturation": "^2.10.3",
    "@zip.js/zip.js": "^2.8.26",
    "bs58check": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^1.20.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-doctor": "^0.9.2",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
