{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "AllowedMethods": ["GET", "HEAD", "PUT"],
      "AllowedHeaders": [
        "content-type",
        "range",
        "x-amz-checksum-sha256"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "x-amz-checksum-sha256"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
