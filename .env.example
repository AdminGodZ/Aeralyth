AERALYTH_API_HOST=0.0.0.0
AERALYTH_API_PORT=8080
AERALYTH_ENV=development
DATABASE_URL=postgres://aeralyth:aeralyth@localhost:5432/aeralyth
AERALYTH_DB_POOL_MAX=8
AERALYTH_DB_POOL_WAIT_MS=1000
AERALYTH_STORAGE_BACKEND=local
AERALYTH_STORAGE_PATH=./data/files
AERALYTH_STORAGE_QUOTA_BYTES=10737418240
AERALYTH_STORAGE_PRESIGN_SECONDS=900
AERALYTH_MULTIPART_THRESHOLD_BYTES=104857600
AERALYTH_MULTIPART_PART_BYTES=67108864

# Production S3-compatible storage (Railway bucket variables can be referenced here).
# AERALYTH_STORAGE_BACKEND=s3
# BUCKET=
# ENDPOINT=
# REGION=
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# AERALYTH_S3_URL_STYLE=virtual
