# AERALYTH_API_HOST=0.0.0.0
# AERALYTH_API_PORT=8080
# AERALYTH_API_ORIGIN=http://127.0.0.1:8080
# Production ingress must route /api/* directly to this origin. Set the escape
# hatch below only when running `next start` without an ingress/load balancer.
# AERALYTH_ENABLE_NEXT_API_PROXY=true
# AERALYTH_ENV=development
# E2EE rollout: off, migrate, or required. migrate/required require S3.
# AERALYTH_E2EE_MODE=off
# Required in production. Generate once with: openssl rand -base64 32
# AERALYTH_SHARE_LINK_SECRET=

# DATABASE_URL=postgres://example:example@localhost:5432/example
# AERALYTH_DB_POOL_MAX=8
# AERALYTH_DB_POOL_WAIT_MS=1000
# Bounded expensive-route admission. Saturated upload work returns 429;
# recursive and provider work return 503 with Retry-After.
# AERALYTH_UPLOAD_CONTROL_CONCURRENCY=8
# AERALYTH_UPLOAD_CONTROL_PER_USER=3
# AERALYTH_RECURSIVE_OPERATION_CONCURRENCY=2
# AERALYTH_RECURSIVE_OPERATION_PER_USER=1
# AERALYTH_STORAGE_OPERATION_CONCURRENCY=16
# AERALYTH_STORAGE_OPERATION_PER_USER=8
# AERALYTH_STORAGE_OPERATION_QUEUE_CAPACITY=32
# AERALYTH_STORAGE_OPERATION_PER_USER_QUEUE_CAPACITY=16

# AERALYTH_STORAGE_BACKEND=s3
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_DEFAULT_REGION=
# AWS_S3_URL_STYLE=virtual

# AERALYTH_STORAGE_QUOTA_BYTES=10737418240
# AERALYTH_STORAGE_PRESIGN_SECONDS=900
# AERALYTH_MULTIPART_THRESHOLD_BYTES=104857600
# AERALYTH_MULTIPART_PART_BYTES=33554432
# AERALYTH_MULTIPART_ORPHAN_GRACE_SECONDS=3600
# Compatible S3 providers only. Railway Storage Buckets do not currently support lifecycle rules.
# AERALYTH_S3_ABORT_INCOMPLETE_MULTIPART_DAYS=7
# AERALYTH_STORAGE_MAINTENANCE_CONCURRENCY=8

# Exact browser origin used by Content Security Policy for direct S3 requests.
# AERALYTH_S3_CSP_ORIGIN=https://example-bucket.up.railway.app

# Railway production uses the same public origin for Next.js and Actix through
# the bundled Caddy ingress. Keep the API origin private to the container.
# AERALYTH_API_ORIGIN=http://127.0.0.1:8081
# AERALYTH_COOKIE_SECURE=true
