from pathlib import Path
import subprocess, json, os, time, datetime, hashlib, sys
root=Path('/Users/timheld/Documents/Projects/Aeralyth')
source=Path('/private/tmp/aeralyth-production-final-source-20260912')
results=root/'performance/results/production-final-2026-09-12'
image='aeralyth-audit-20260912:current'
container='aeralyth-audit-production-20260912'
network='aeralyth-audit-integration-20260912'
database='aeralyth_audit_production_final'
postgres='aeralyth-audit-20260912'
node='/opt/homebrew/bin/node'
record={'acceptanceRunnerSha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'startedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'image':image,'container':container,'steps':[],'passed':False,'gatesPassed':False,'sourceCurrent':None,'attempt':2,'status':'final-artifact-running'}

def save():
 (results/'acceptance.json').write_text(json.dumps(record,indent=2)+'\n')

def run(name,args,env=None,timeout=180,expected=0,input=None):
 start=time.monotonic()
 with (results/f'{name}.log').open('w') as log:
  completed=subprocess.run(args,env=env,input=input,text=True,stdout=log,stderr=subprocess.STDOUT,timeout=timeout,cwd=source)
 text=(results/f'{name}.log').read_text()
 record['steps'].append({'name':name,'exitCode':completed.returncode,'expectedExitCode':expected,'elapsedSeconds':round(time.monotonic()-start,3),'passed':completed.returncode==expected})
 save()
 print(name, completed.returncode, flush=True)
 if completed.returncode!=expected: raise RuntimeError(f'{name} failed; see {results/name}.log')
 return text

def docker(*args): return ['docker',*args]

def runtime_args(public_port):
 values={
  'PORT':str(public_port),'DATABASE_URL':f'postgres://aeralyth:aeralyth@{postgres}:5432/{database}',
  'AERALYTH_ENV':'production','AERALYTH_COOKIE_SECURE':'true','AERALYTH_E2EE_MODE':'required',
  'AERALYTH_DB_POOL_MAX':'8','AERALYTH_DB_POOL_MIN':'2','AERALYTH_DB_MAINTENANCE_POOL_MAX':'2',
  'AERALYTH_STORAGE_BACKEND':'s3','AERALYTH_STORAGE_QUOTA_BYTES':'1073741824',
  'AWS_ENDPOINT_URL':'http://host.docker.internal:59000','AWS_ACCESS_KEY_ID':'aeralyth-audit-access',
  'AWS_SECRET_ACCESS_KEY':'aeralyth-audit-secret-key-20260912','AWS_S3_BUCKET_NAME':'aeralyth-audit-production-final',
  'AWS_DEFAULT_REGION':'us-east-1','AWS_S3_URL_STYLE':'path',
  'AERALYTH_S3_CSP_ORIGIN':'http://host.docker.internal:59000',
  'AERALYTH_SHARE_LINK_SECRET':'aeralyth-audit-local-share-secret-20260912',
  'AERALYTH_METRICS_TOKEN':'aeralyth-audit-metrics-token-20260912',
 }
 args=docker('run','--detach','--name',container,'--network',network,'--publish',f'127.0.0.1:58082:{public_port}','--cpus','2','--memory','2g')
 for key,value in values.items(): args+=['-e',f'{key}={value}']
 return args+[image]

def wait_ready():
 for _ in range(90):
  response=subprocess.run(['curl','--fail','--silent','--max-time','2','http://127.0.0.1:58082/health/ready'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  if response.returncode==0:return
  time.sleep(1)
 raise RuntimeError('production Caddy listener did not become ready')

def smoke(label,api_port):
 run(f'{label}-health',['curl','--fail','--silent','--show-error','http://127.0.0.1:58082/health'])
 run(f'{label}-api-health',['curl','--fail','--silent','--show-error','http://127.0.0.1:58082/api/health'])
 html=run(f'{label}-login',['curl','--fail','--silent','--show-error','http://127.0.0.1:58082/login'])
 if 'Welcome back' not in html:raise RuntimeError('login did not render expected production page')
 run(f'{label}-worker-http',[node,str(source/'scripts/test-worker-http.mjs'),'http://127.0.0.1:58082'])
 logs=run(f'{label}-runtime-log',docker('logs',container))
 if f'127.0.0.1:{api_port}' not in logs:raise RuntimeError('unexpected internal API port')

def current_build_input_identity():
 identity=json.loads((results/'source-identity.json').read_text())
 documentation={
  'AGENTS.md','CLAUDE.md','README.md','Aeralyth_Performance_Latency_Audit_2026-09-12.md',
  'Proton Drive Low-Latency E2EE Architecture.md','database/IDENTIFIER_STORAGE_POLICY.md',
  'database/MIGRATIONS.md','deployment/worker-assets/README.md',
 }
 def relevant(name):
  return not name.startswith(('docs/','performance/results/')) and name not in documentation
 expected={item['path']:item['sha256'] for item in identity['files'] if relevant(item['path'])}
 visible=subprocess.check_output(['git','ls-files','-z','--cached','--others','--exclude-standard'],cwd=root).split(b'\0')
 current={}
 for raw in sorted(set(visible)):
  if not raw:continue
  name=raw.decode()
  if not relevant(name):continue
  p=root/name
  if not p.exists() and not p.is_symlink():continue
  if not p.is_file() and not p.is_symlink():continue
  data=p.read_bytes() if not p.is_symlink() else str(p.readlink()).encode()
  current[name]=hashlib.sha256(data).hexdigest()
 changed=[]
 for name in sorted(set(expected)|set(current)):
  if name not in expected:changed.append({'path':name,'change':'added'})
  elif name not in current:changed.append({'path':name,'change':'removed'})
  elif expected[name]!=current[name]:changed.append({'path':name,'change':'modified'})
 digest=lambda manifest:hashlib.sha256(json.dumps(manifest,sort_keys=True,separators=(',',':')).encode()).hexdigest()
 return {
  'observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),
  'policy':'All git-visible inputs; only explicit non-imported documentation, audit reports, and generated validation results are excluded. New and removed paths are included.',
  'excludedPrefixes':['docs/','performance/results/'],'excludedDocumentation':sorted(documentation),
  'snapshotBuildInputSha256':digest(expected),'currentBuildInputSha256':digest(current),
  'snapshotFiles':len(expected),'currentFiles':len(current),'changedPaths':changed,
  'sourceCurrent':not changed,'snapshotManifest':expected,'currentManifest':current,
 }

def runtime_dependency_identity(broad):
 excluded='performance/observability-probe.mjs'
 expected={k:v for k,v in broad['snapshotManifest'].items() if k!=excluded}
 current={k:v for k,v in broad['currentManifest'].items() if k!=excluded}
 digest=lambda manifest:hashlib.sha256(json.dumps(manifest,sort_keys=True,separators=(',',':')).encode()).hexdigest()
 changed=[item for item in broad['changedPaths'] if item['path']!=excluded]
 return {'policy':'All broad build inputs except the separately reviewed external observability probe. The probe is available only in the Docker build context; package build commands and production workload imports do not execute it, and final runtime inspection verifies it is absent.',
  'externalNonDependency':excluded,'snapshotSha256':digest(expected),'currentSha256':digest(current),
  'snapshotFiles':len(expected),'currentFiles':len(current),'changedPaths':changed,'sourceCurrent':not changed,
  'excludedExternalProbeSnapshotSha256':broad['snapshotManifest'].get(excluded),
  'excludedExternalProbeCurrentSha256':broad['currentManifest'].get(excluded)}

try:
 record['source']=json.loads((results/'source-identity.json').read_text())
 record['source'].pop('files')
 record['buildInputIdentityBefore']=current_build_input_identity()
 (results/'build-input-identity-before.json').write_text(json.dumps(record['buildInputIdentityBefore'],indent=2)+'\n')
 record['runtimeDependencyIdentityBefore']=runtime_dependency_identity(record['buildInputIdentityBefore'])
 record['broadSnapshotCurrentBefore']=record['buildInputIdentityBefore']['sourceCurrent']
 record['runtimeSourceDriftBefore']=record['runtimeDependencyIdentityBefore']['changedPaths']
 if record['runtimeSourceDriftBefore']:raise RuntimeError('runtime source changed after final snapshot; rebuild before acceptance')
 record['imageId']=run('image-id',docker('image','inspect',image,'--format','{{.Id}}')).strip()
 record['externalProbeRuntimeAbsence']=run('external-probe-not-in-runtime',docker('run','--rm','--entrypoint','node',image,'-e',"const fs=require('node:fs'); const found=[]; function walk(p){for(const d of fs.readdirSync(p,{withFileTypes:true})){const f=p+'/'+d.name; if(d.name==='observability-probe.mjs')found.push(f); if(d.isDirectory())walk(f);}} walk('/app'); console.log(JSON.stringify({searched:'/app',found})); if(found.length)process.exit(1);")).strip()
 record['binarySha256']=run('binary-sha256',docker('run','--rm','--entrypoint','sha256sum',image,'/app/bin/aeralyth-api')).split()[0]
 record['nodeClient']=subprocess.check_output([node,'--version'],text=True).strip()
 record['providerDnsPreloadSha256']=hashlib.sha256(Path('/private/tmp/aeralyth-audit-provider-dns.cjs').read_bytes()).hexdigest()
 record['resources']={'cpus':2,'memoryBytes':2147483648,'databasePoolMax':8,'maintenancePoolMax':2,'e2eeMode':'required','quotaBytes':1073741824}
 migration=docker('run','--rm','--network',network,'-e',f'DATABASE_URL=postgres://aeralyth:aeralyth@{postgres}:5432/{database}','-e','AERALYTH_ENV=production',image,'/app/scripts/migrate-production.sh')
 initial=run('fresh-image-migration-preflight',migration,expected=3)
 if 'production refuses to start while an account uses the local seed password' not in initial:raise RuntimeError('initial migration did not reach expected production preflight guard')
 run('rotate-isolated-seed-password',docker('exec','-i',postgres,'psql','-X','-v','ON_ERROR_STOP=1','-U','aeralyth','-d',database),input="UPDATE users SET password_hash=crypt('aeralyth-production-audit-password',gen_salt('bf')) WHERE id='usr_admingod';\n")
 run('image-migration-replay-preflight',migration)
 run('start-standard',runtime_args(8080))
 wait_ready()
 record['dockerRuntime']=json.loads(run('runtime-resource-identity',docker('inspect',container,'--format','{"nanoCpus":{{.HostConfig.NanoCpus}},"memory":{{.HostConfig.Memory}},"ports":{{json .HostConfig.PortBindings}},"image":{{json .Image}}}')))
 smoke('standard',8081)
 workload=os.environ.copy()
 workload.pop('AERALYTH_PERF_API_PID',None)
 workload.update({
  'NODE_OPTIONS':'--require=/private/tmp/aeralyth-audit-provider-dns.cjs',
  'AERALYTH_PERF_ISOLATED':'1','AERALYTH_PERF_URL':'http://127.0.0.1:58082/health',
  'AERALYTH_PERF_DATABASE_CONTAINER':postgres,'AERALYTH_PERF_DATABASE_NAME':database,
  'AERALYTH_METRICS_TOKEN':'aeralyth-audit-metrics-token-20260912',
  'AERALYTH_PERF_PROVIDER_HOSTS':'host.docker.internal:59000',
  'AERALYTH_PERF_BUILD_PROFILE':'production-image','AERALYTH_PERF_ROUTING':'caddy',
  'AERALYTH_PERF_BUILD_ID':record['source']['baseCommit']+':'+record['source']['sourceManifestSha256']+':'+record['imageId'],
  'AERALYTH_PERF_MEMORY_CONTAINER':container,'AERALYTH_PERF_OUTPUT':str(results/'mixed-30s.json'),
  'AERALYTH_PERF_DURATION_SECONDS':'30','AERALYTH_PERF_BASELINE_SECONDS':'5','AERALYTH_PERF_RECOVERY_SECONDS':'5',
  'AERALYTH_PERF_ARRIVAL_RATE':'10','AERALYTH_PERF_CONCURRENCY':'32','AERALYTH_PERF_TIMEOUT_MS':'5000',
  'AERALYTH_PERF_ENFORCE_THRESHOLDS':'1','AERALYTH_PERF_MAX_ERROR_RATE':'0','AERALYTH_PERF_MAX_DROPPED_RATE':'0',
  'AERALYTH_PERF_MAX_P99_MS':'1000','AERALYTH_PERF_MAX_P95_MS':'500',
  'AERALYTH_PERF_IDLE_SECONDS':'2','AERALYTH_PERF_IDLE_SETTLE_MS':'1000','AERALYTH_PERF_MAX_IDLE_MAINTENANCE_RUNS_PER_SECOND':'10',
 })
 run('http-smoke',[node,str(source/'performance/http-load.mjs')],env=workload)
 run('mixed-30s',[node,str(source/'performance/mixed-load.mjs')],env=workload,timeout=300)
 workload['AERALYTH_PERF_FAULT_OUTPUT']=str(results/'database-stall.json')
 run('database-stall-acceptance',[node,str(source/'performance/mixed-load-self-test.mjs')],env=workload,timeout=300)
 workload['AERALYTH_PERF_DURATION_SECONDS']='300'
 workload['AERALYTH_PERF_OUTPUT']=str(results/'mixed-300s.json')
 run('mixed-300s',[node,str(source/'performance/mixed-load.mjs')],env=workload,timeout=600)
 # Give the independent worker reviewer a bounded, quiet window after timing.
 proof_ready=results/'independent-worker-proof-ready.json'
 proof_done=results/'independent-worker-proof-done.json'
 proof_ready.write_text(json.dumps({'imageId':record['imageId'],'binarySha256':record['binarySha256'],'source':record['source'],'origin':'http://127.0.0.1:58082'},indent=2)+'\n')
 print('independent-worker-proof-ready',flush=True)
 handoff_deadline=time.monotonic()+60
 while not proof_done.exists() and time.monotonic()<handoff_deadline:time.sleep(1)
 record['independentWorkerProofCompletedDuringHandoff']=proof_done.exists()
 save()
 run('standard-final-log',docker('logs',container))
 run('stop-standard',docker('stop','--time','45',container),timeout=90)
 run('remove-standard',docker('rm',container))
 run('start-colliding',runtime_args(8081))
 wait_ready()
 smoke('colliding',18080)
 run('stop-colliding',docker('stop','--time','45',container),timeout=90)
 run('remove-colliding',docker('rm',container))
 record['gatesPassed']=True
 record['buildInputIdentityAfter']=current_build_input_identity()
 (results/'build-input-identity-after.json').write_text(json.dumps(record['buildInputIdentityAfter'],indent=2)+'\n')
 record['runtimeDependencyIdentityAfter']=runtime_dependency_identity(record['buildInputIdentityAfter'])
 record['broadSnapshotCurrentAfter']=record['buildInputIdentityAfter']['sourceCurrent']
 record['runtimeSourceDriftAfter']=record['runtimeDependencyIdentityAfter']['changedPaths']
 record['sourceCurrent']=not record['runtimeSourceDriftAfter']
 if not record['sourceCurrent']:raise RuntimeError('runtime source changed during acceptance; final snapshot must be refreshed')
 record['sourceCurrencyPolicy']='sourceCurrent refers to image runtime/build and executed production workload dependencies; broadSnapshotCurrentAfter separately reports drift in the conservative407-file snapshot.'
 record['hashSemantics']='Source/build manifest digests hash canonical JSON data; they do not hash the formatting bytes of report JSON. Individual source/binary/asset digests hash file bytes.'
 record['passed']=True
 record['finalAcceptance']=True
 record['status']='final-artifact-passed'
except Exception as error:
 record['error']=str(error)
 print(str(error),flush=True)
 subprocess.run(docker('logs',container),stdout=(results/'failure-runtime.log').open('w'),stderr=subprocess.STDOUT)
 raise
finally:
 record['finishedAt']=datetime.datetime.now(datetime.timezone.utc).isoformat()
 save()
