{
	admin off
	auto_https off
	grace_period 30s
	servers {
		# Railway's edge reaches the container from its private ingress range
		# and records the client in X-Forwarded-For. Only that hop is trusted to
		# supply {client_ip}; any other peer is the client itself.
		trusted_proxies static {$AERALYTH_TRUSTED_PROXY_RANGES:100.64.0.0/10}
		client_ip_headers X-Forwarded-For
		max_header_size 64KB
		timeouts {
			read_header 10s
			read_body 10m
			write 30m
			idle 2m
		}
	}
}

:{$PORT:8080} {
	encode zstd gzip {
		minimum_length 1024
		match {
			header Content-Type application/json*
			header Content-Type application/problem+json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
		}
	}

	handle /workers/* {
		root * /app/frontend/public
		@existingWorker file
		handle @existingWorker {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				CDN-Cache-Control "public, max-age=31536000, immutable"
			}
			file_server
		}
		handle {
			# A missing release must remain recoverable after rollout. Never cache
			# its 404 for the immutable asset's one-year lifetime.
			header Cache-Control "no-store"
			respond "Worker asset unavailable. Reload the application and retry." 404
		}
	}

	@api path /api/* /health /health/* /metrics
	handle @api {
		reverse_proxy 127.0.0.1:{$AERALYTH_API_PORT:8081} {
			# The API trusts X-Forwarded-For only from this loopback hop and keys
			# login rate limits on it, so pass exactly the resolved client.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{$AERALYTH_FRONTEND_PORT:3000}
	}
}
