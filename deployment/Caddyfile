{
	admin off
	auto_https off
	grace_period 30s
	servers {
		# Railway's edge reaches the container from its private ingress range
		# and records the client in X-Forwarded-For. Only that hop is trusted to
		# supply {client_ip}; any other peer is the client itself.
		trusted_proxies static {$AERALYTH_TRUSTED_PROXY_RANGES:100.64.0.0/10}
		client_ip_headers X-Forwarded-For
		max_header_size 64KB
		timeouts {
			read_header 10s
			read_body 10m
			write 30m
			idle 2m
		}
	}
}

:{$PORT:8080} {
	# TLS ends at the public edge, so every response that reaches a browser was
	# served over HTTPS. Pin browsers to it so a later visit cannot be downgraded.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	encode zstd gzip {
		minimum_length 1024
		match {
			header Content-Type application/json*
			header Content-Type application/problem+json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
		}
	}

	# Optional origin lock. A CDN in front of Railway only protects the app if
	# the app refuses visitors who skip it, and Railway's edge answers for a
	# custom domain to anyone who connects to it directly. List the CDN's
	# addresses here to turn every other caller away; the default admits all.
	# Health checks stay open because Railway probes them from inside.
	@outsideEdge {
		not client_ip {$AERALYTH_ALLOWED_EDGE_RANGES:0.0.0.0/0 ::/0}
		not path /health /health/*
	}
	rewrite @outsideEdge /forbidden-origin
	handle /forbidden-origin {
		respond "This origin only accepts requests through its edge network." 403
	}

	handle /workers/* {
		root * /app/frontend/public
		@existingWorker file
		handle @existingWorker {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				CDN-Cache-Control "public, max-age=31536000, immutable"
			}
			file_server
		}
		handle {
			# A missing release must remain recoverable after rollout. Never cache
			# its 404 for the immutable asset's one-year lifetime.
			header Cache-Control "no-store"
			respond "Worker asset unavailable. Reload the application and retry." 404
		}
	}

	@api path /api/* /health /health/* /metrics
	handle @api {
		# Behind Cloudflare, Railway reports Cloudflare's address and the visitor
		# is only in CF-Connecting-IP. Anyone can send that header, so it counts
		# only when the address Railway resolved is one of Cloudflare's own.
		@throughCloudflare {
			client_ip {$AERALYTH_CLOUDFLARE_RANGES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
			header CF-Connecting-IP *
		}
		route {
			vars client_address {client_ip}
			vars @throughCloudflare client_address {http.request.header.CF-Connecting-IP}
			reverse_proxy 127.0.0.1:{$AERALYTH_API_PORT:8081} {
				# The API trusts X-Forwarded-For only from this loopback hop and keys
				# login rate limits on it, so pass exactly the resolved client.
				header_up X-Forwarded-For {vars.client_address}
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{$AERALYTH_FRONTEND_PORT:3000}
	}
}
